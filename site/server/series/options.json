  "events": [
    {
      "name": "optBlocks",
      "description": "Large option prints: premium in USD, positive for calls, negative for puts",
      "when": {
        "random": {
          "perDay": 5
        }
      },
      "labels": [
        "Call",
        "Put"
      ],
      "value": {
        "flow": {
          "scale": 25000000.0,
          "beta": 0.6
        }
      }
    },
    {
      "name": "optEarnings",
      "description": "Quarterly earnings dates; value is the implied earnings move from options, percent",
      "when": {
        "every": {
          "days": 91
        }
      },
      "labels": [
        "Earnings"
      ],
      "value": {
        "osc": {
          "center": 6.5,
          "amp": 1.4,
          "lo": 3,
          "hi": 12
        }
      }
    }
