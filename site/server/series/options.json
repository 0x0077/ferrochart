{
  "series": [
    {
      "name": "optAtmIv",
      "description": "At-the-money 30-day implied volatility (any symbol); rises when the price falls",
      "unit": "fraction per year",
      "cols": [
        {
          "name": "iv",
          "osc": {
            "center": 0.45,
            "amp": 0.05,
            "beta": -0.5,
            "lo": 0.15,
            "hi": 1.2
          }
        }
      ]
    },
    {
      "name": "optPutCall",
      "description": "Put/call ratio of daily option volume; rises when the price falls",
      "unit": "ratio",
      "cols": [
        {
          "name": "ratio",
          "osc": {
            "center": 0.92,
            "amp": 0.2,
            "beta": -0.6,
            "lo": 0.45,
            "hi": 2.2
          }
        }
      ]
    },
    {
      "name": "optSkew",
      "description": "25-delta risk reversal (call minus put IV) and butterfly (wings minus ATM IV), 30-day",
      "unit": "vol points",
      "cols": [
        {
          "name": "rr",
          "osc": {
            "center": -1.2,
            "amp": 2.2,
            "beta": 0.6
          }
        },
        {
          "name": "bf",
          "osc": {
            "center": 0.9,
            "amp": 0.35,
            "beta": -0.2,
            "lo": 0.15
          }
        }
      ]
    },
    {
      "name": "optVolume",
      "description": "Daily option volume across all strikes",
      "unit": "contracts",
      "cols": [
        {
          "name": "contracts",
          "amount": {
            "scale": 60000,
            "vol": 0.3,
            "beta": 0.25
          }
        }
      ]
    },
    {
